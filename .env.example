# ============================================
# SIG Maps Environment Configuration Template
# ============================================
# IMPORTANT: Copy this file to .env and fill in your values
# NEVER commit .env with real credentials to version control

# PostgreSQL Database Configuration
POSTGRES_DB=sig_db
POSTGRES_USER=sig_user
POSTGRES_PASSWORD=<YOUR_SECURE_PASSWORD_HERE>

# Spring Datasource (used by backend)
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/sig_db
SPRING_DATASOURCE_USERNAME=sig_user
SPRING_DATASOURCE_PASSWORD=<YOUR_SECURE_PASSWORD_HERE>

# Backend Configuration
JAVA_OPTS=-Xms2048m -Xmx4096m

# JWT Secret (GENERATE A SECURE 256-BIT SECRET)
JWT_SECRET=<GENERATE_A_SECURE_256_BIT_SECRET>

# Jasypt Encryption
JASYPT_ENCRYPTOR_PASSWORD=<YOUR_JASYPT_SECRET_HERE>

# Frontend Configuration
API_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:80

# Email Configuration
MAIL_HOST=<YOUR_MAIL_HOST>
MAIL_PORT=465
MAIL_USERNAME=<YOUR_MAIL_USERNAME>
MAIL_PASSWORD=<YOUR_MAIL_PASSWORD>

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=<YOUR_REDIS_PASSWORD>

# GeoServer Configuration
GEOSERVER_REST_PASSWORD=<YOUR_GEOSERVER_PASSWORD>
